<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp"
    android:background="#1A1A1A" android:gravity="center_horizontal">

    <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/ic_logo" android:layout_marginBottom="8dp" android:layout_marginTop="15dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@exhxx78" android:textColor="#FFC107" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="25dp"/>

    <EditText android:id="@+id/etServer" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Target Server (IP)" android:textColorHint="#666" android:textColor="#FFF" android:background="#262626" android:padding="12dp" android:layout_marginBottom="12dp" android:singleLine="true"/>
    <EditText android:id="@+id/etPort" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Port" android:textColorHint="#666" android:textColor="#FFF" android:background="#262626" android:padding="12dp" android:layout_marginBottom="12dp" android:singleLine="true" android:inputType="number"/>
    <EditText android:id="@+id/etUuid" android:layout_width="match_parent" android:layout_height="48dp" android:hint="UUID" android:textColorHint="#666" android:textColor="#FFF" android:background="#262626" android:padding="12dp" android:layout_marginBottom="12dp" android:singleLine="true"/>
    <EditText android:id="@+id/etPayload" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Payload (e.g. HTTP/78 2026)" android:textColorHint="#666" android:textColor="#FFF" android:background="#262626" android:padding="12dp" android:layout_marginBottom="15dp" android:singleLine="true"/>

    <CheckBox android:id="@+id/cbAutoConnect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto Connect on App Start" android:textColor="#999" android:layout_marginBottom="15dp" android:buttonTint="#FFC107"/>

    <Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="52dp" android:text="CONNECT" android:textColor="#1A1A1A" android:backgroundTint="#FFC107" android:textStyle="bold" android:layout_marginBottom="15dp"/>
    
    <TextView android:id="@+id/tvPing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ping: -- ms" android:textColor="#00FF00" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="15dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SYSTEM LOGS" android:textColor="#666" android:textSize="12sp" android:textStyle="bold" android:layout_gravity="start" android:layout_marginBottom="4dp"/>
    <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#0A0A0A" android:padding="10dp">
        <TextView android:id="@+id/tvLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#00FF00" android:textSize="11sp" android:fontFamily="monospace" android:text="Waiting for connection..."/>
    </ScrollView>

</LinearLayout>
